#!/bin/bash
#SBATCH --job-name=stage2_A_2k_2nd_step
#SBATCH --partition=gpu_h100
#SBATCH --gpus=2
#SBATCH --time=48:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --mem=120G
#SBATCH --output=log_ss2/stage2_A_2k_2nd_step%j.out
#SBATCH --error=log_ss2/stage2_A_2k_2nd_step%j.err

# ============================================================================
# CAN3TOK STAGE 2 — Strategy A
# ============================================================================
#
# Run in TWO sequential submissions:
#
#   Submission 1 — Layout DiT (STAGE=layout):
#       Learns P(z_s) — distribution of semantic layout tokens [B, 16, 32].
#       This checkpoint is SHARED with Strategy D — no need to retrain it.
#
#   Submission 2 — Geometry DiT (STAGE=geometry):
#       Learns P(z_g | z_s_clean) — geometry conditioned on clean z_s.
#       z_s conditions every DiT block via cross-attention K/V (default).
#       Ablation: set ZS_CONDITIONING=adaLN to test pooled conditioning.
#
# Ablation experiments:
#   Run STAGE=geometry twice:
#     ZS_CONDITIONING=cross_attn  →  GeometryDiTA with cross-attention
#     ZS_CONDITIONING=adaLN       →  GeometryDiT_adaLN with pooled z_s
#   Compare generation quality to measure how much per-token z_s structure
#   matters.  The checkpoint run_name embeds the conditioning type so both
#   runs can coexist in checkpoints_stage2/.
#
# ============================================================================

echo "Job ID: $SLURM_JOB_ID  |  Node: $SLURM_NODELIST  |  Start: $(date)"

# ============================================================================
# CONFIGURATION  — edit these before submitting
# ============================================================================

# ── Stage 1 checkpoint (Strategy A — latent_disentangle=True) ─────────────────
STAGE1_CHECKPOINT="/home/yli11/scratch-project/Hafeez_thesis/Can3Tok/checkpoints/RGB_job_21860551_hidden_colorresidual_disent512_fourierpe_layout_semTok_poolNCE_pgNCE_inferencefixed/best_model.pth"
STAGE1_CONFIG="./model/configs/aligned_shape_latents/shapevae-256.yaml"

# ── Step: layout (Submission 1) | geometry (Submission 2) ────────────────────
STAGE="geometry"           # layout | geometry

# ── Layout checkpoint — required for STAGE=geometry ──────────────────────────
LAYOUT_CKPT="/home/yli11/scratch-project/Hafeez_thesis/Can3Tok/checkpoints_stage2/stage2_A_layout_B_22414639"           # e.g. checkpoints_stage2/stage2_A_layout_B_JOBID/best_model.pth

# ── z_s conditioning — only applies to STAGE=geometry ────────────────────────
# cross_attn : dedicated cross-attention per block   ← default, recommended
# adaLN      : pooled z_s added to t_embed           ← ablation
ZS_CONDITIONING="cross_attn"

# ── Resume a previous geometry run (optional) ─────────────────────────────────
RESUME_CHECKPOINT=""

# ── Model size: S (fast smoke-test) | B (default) | L (best quality) ─────────
MODEL_SIZE="B"

# ── Training ──────────────────────────────────────────────────────────────────
BATCH_SIZE=64
NUM_EPOCHS=5000
LR=1e-4
WEIGHT_DECAY=1e-2
WARMUP_STEPS=500        # longer warmup for longer run
LR_MIN_RATIO=0.05       # floor = 5e-6 instead of 1e-5; gives meaningful LR longer
EVAL_EVERY=50           # less frequent eval saves time over 2000 epochs
TRAIN_SCENES=1000       # use more of SceneSplat-7K; 300 was for quick testing
VAL_SCENES=100

# ── Visualization & diagnostics ────────────────────────────────────────────────
# VIS_FREQ: save generated PLY every N epochs (0=off).
# geometry stage: uses real z_s from val encoder + generated z_g — best qualitative signal.
VIS_FREQ=50
VIS_NUM_SCENES=4
VIS_NUM_STEPS=50
# FLOW_DIAG_FREQ: print velocity field diagnostics every N epochs (0=off).
# Prints cosine(v_pred, v_target), per-t-bin loss, v_pred/v_target std.
FLOW_DIAG_FREQ=50

# ============================================================================
# ENVIRONMENT
# ============================================================================

module purge && module load 2023 && module load CUDA/12.1.1
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export PATH="/home/yli11/.conda/envs/can3tok/bin:$PATH"
export LD_LIBRARY_PATH="/home/yli11/.conda/envs/can3tok/lib/python3.11/site-packages/torch/lib:$LD_LIBRARY_PATH"

cd /home/yli11/scratch-project/Hafeez_thesis/Can3Tok
mkdir -p logs

# Create log directories BEFORE anything writes to them
mkdir -p log_ss2



# ============================================================================
# VALIDATION
# ============================================================================

if [[ "$STAGE1_CHECKPOINT" == *"<YOUR"* ]]; then
    echo "ERROR: Set STAGE1_CHECKPOINT before submitting."
    exit 1
fi
if [ "$STAGE" = "geometry" ] && [ -z "$LAYOUT_CKPT" ]; then
    echo "ERROR: Set LAYOUT_CKPT for --stage geometry."
    exit 1
fi

echo "========================================================================"
echo "  Stage 2 — Strategy A — Stage: $STAGE"
if [ "$STAGE" = "geometry" ]; then
    echo "  z_s conditioning: $ZS_CONDITIONING"
fi
echo "  Stage 1: $STAGE1_CHECKPOINT"
echo "  Model size: $MODEL_SIZE"
echo "========================================================================"

# ============================================================================
# BUILD COMMAND
# ============================================================================

ACCELERATE_CONFIG="./job_scripts/accelerate_config.yaml"

CMD="accelerate launch --config_file $ACCELERATE_CONFIG stage2/train_stage2.py"
CMD="$CMD --strategy A --stage $STAGE"
CMD="$CMD --stage1_checkpoint $STAGE1_CHECKPOINT"
CMD="$CMD --stage1_config $STAGE1_CONFIG"
CMD="$CMD --model_size $MODEL_SIZE"
CMD="$CMD --batch_size $BATCH_SIZE --num_epochs $NUM_EPOCHS"
CMD="$CMD --lr $LR --weight_decay $WEIGHT_DECAY"
CMD="$CMD --warmup_steps $WARMUP_STEPS --lr_min_ratio $LR_MIN_RATIO"
CMD="$CMD --eval_every $EVAL_EVERY"
CMD="$CMD --train_scenes $TRAIN_SCENES --val_scenes $VAL_SCENES"
CMD="$CMD --vis_freq $VIS_FREQ --vis_num_scenes $VIS_NUM_SCENES --vis_num_steps $VIS_NUM_STEPS"
CMD="$CMD --flow_diag_freq $FLOW_DIAG_FREQ"

if [ "$STAGE" = "geometry" ]; then
    CMD="$CMD --zs_conditioning $ZS_CONDITIONING"
fi
[ -n "$RESUME_CHECKPOINT" ] && CMD="$CMD --resume_checkpoint $RESUME_CHECKPOINT"

echo "Command: $CMD"
echo ""

# ============================================================================
# RUN
# ============================================================================

SECONDS=0
eval $CMD
EXIT=$?
echo ""
echo "Exit: $EXIT  |  Duration: $((SECONDS/60))m $((SECONDS%60))s  |  End: $(date)"

if [ $EXIT -eq 0 ]; then
    echo ""
    echo "COMPLETED — Strategy A, stage=$STAGE"
    if [ "$STAGE" = "layout" ]; then
        echo ""
        echo "  Next steps:"
        echo "    1. Set LAYOUT_CKPT to the best_model.pth from this run"
        echo "    2. Set STAGE=geometry"
        echo "    3. Submit twice: once with ZS_CONDITIONING=cross_attn (default)"
        echo "                     once with ZS_CONDITIONING=adaLN (ablation)"
        echo ""
        echo "  This layout checkpoint can also be reused for Strategy D!"
    else
        echo "  Generation command:"
        echo "    python stage2/sample_stage2.py \\"
        echo "      --strategy A \\"
        echo "      --stage1_checkpoint $STAGE1_CHECKPOINT \\"
        echo "      --layout_checkpoint $LAYOUT_CKPT \\"
        echo "      --geometry_checkpoint checkpoints_stage2/stage2_A_geometry_${ZS_CONDITIONING}_B_${SLURM_JOB_ID}/best_model.pth \\"
        echo "      --num_samples 8 --num_steps 50 --output_dir ./generated_A_${ZS_CONDITIONING}/"
    fi
else
    echo "FAILED (exit $EXIT)"
    echo "  cat logs/stage2_A_${SLURM_JOB_ID}.err | tail -30"
fi
