#!/bin/bash
#SBATCH --job-name=can3tok_canvox_snap_scale
#SBATCH --partition=gpu_h100
#SBATCH --gpus=2
#SBATCH --time=15:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --mem=90G
#SBATCH --output=logs_ss1/can3tok_canvox_snap_scale_%j.out
#SBATCH --error=logs_ss1/can3tok_canvox_snap_scale_%j.err

echo "Job ID: $SLURM_JOB_ID  |  Node: $SLURM_NODELIST  |  Start: $(date)"

# ============================================================================
# FULL-SCALE CANONICAL VOXEL SNAP RUN
# ----------------------------------------------------------------------------
# This is the scale-up of the canonical-voxel-snap diagnostic. The overfit
# version (4 chunks, 1000 epochs) was the first run across seven experiments
# in which the model actually learned per-slot rotation and meaningful scale,
# producing visually anisotropic Gaussians. That confirmed the identifiability
# theory: per-slot 3DGS shape is recoverable when position is canonicalized
# to voxel cells (so slot identity = "this cell is occupied"), and unrecoverable
# otherwise.
#
# This run takes the same configuration (R=192 grid, snap=True, plain L2,
# no sigma, no render) and trains it on the full 6,746-scene mix for 500
# epochs. Result is the Stage-1 model for the chapter, plus the empirical-
# results numbers and PLYs that go into the thesis figures.
#
# What is INTENTIONALLY OFF in this run (so the result is interpretable as
# "canonical voxel snap at scale" rather than "snap + a pile of extras"):
#   * No sigma loss, no render loss        -- the snap result was achieved
#                                              without them; adding now muddies.
#   * No semantic / layout / InfoNCE heads -- not part of the snap result.
#   * No cross_recon / ortho / latent_disentangle -- ditto.
# Add these as ablations in follow-up runs if the chapter benefits from them.
# ============================================================================

# ============================================================================
# DATASET SELECTION
# ============================================================================
TRAIN_DATA="chunks"

# ============================================================================
# FLAGS
# ============================================================================

# ── CANONICAL VOXEL (THE WHOLE POINT OF THIS RUN) ────────────────────────────
# Re-express each scene as one representative Gaussian per occupied voxel on
# a fixed canonical grid (canonical_voxel_merge), padded to NUM_GAUSSIANS with
# zero-opacity dummies. The recon loss masks the padding via valid_mask.
#
# VOXEL_RES=256: occupancy ~22-30k of 40k slots per scene -> meaningful merging
# (multiple input Gaussians per cell collapse into one canonical Gaussian) so
# cell identity carries scene-structure information. R=64 is too lossy (~2k
# real / 38k padding); R=256 is too dense (essentially 1:1, no canonicalization
# benefit). 192 is the validated overfit setting.
#
# VOXEL_SNAP=True: position = cell center, no residual. The model does NOT
# predict position; it learns shape/color/opacity conditioned on which cells
# are occupied. This is the configuration that gave the working overfit
# result.  voxel_snap=False (residual variant) failed to learn shape per-slot
# in the overfit comparison -- positions are good but shapes stay isotropic.
CANONICAL_VOXEL=False
VOXEL_RES=256
VOXEL_SNAP=False

# Resume slot (unused for this run; cold start)
RESUME_CHECKPOINT=""
RESUME_EPOCH=""

# ── DECODER LAYOUT / CROSS-ATTN (off; not used in the snap result) ───────────
DECODER_LAYOUT_CROSS_ATTN=False
DECODER_LAYOUT_ADDITIVE=False

# ── TOKEN-LOCAL DECODER ──────────────────────────────────────────────────────
# REQUIRED. Replaces the flat 775M-param GS_decoder with a 1.6M shared per-token
# MLP -- the only configuration that fits at 40k Gaussians and batch 90 on 4 H100s.
TOKEN_LOCAL_DECODER=True

# Separate-heads / cross-stitch off: the snap overfit used the shared head and
# produced the working result. Adding separate heads now would change the
# architecture relative to the diagnostic.
TOKEN_LOCAL_SEPARATE_HEADS=True
TOKEN_LOCAL_HEAD_CROSS_STITCH=False

# ── POSITION SCAFFOLD / ANCHORS ──────────────────────────────────────────────
# SCAFFOLD OFF. Under VOXEL_SNAP=True the position is fully determined by which
# cell is occupied -- there is nothing for the scaffold to add. Anchors do not
# improve a fixed-position decode, and POSITION_SCAFFOLD=False is the cleaner
# comparison against the overfit snap result.
POSITION_SCAFFOLD=False
SCAFFOLD_MODE="hilbert_block"      # inert while POSITION_SCAFFOLD=False
ANCHOR_RELATIVE_DECODE=False
ANCHOR_TEACHER_FORCE=False
OFFSET_SCALE_INIT=2.0
ANCHOR_LOSS_WEIGHT=1.0

# ── LOCAL ENCODER + LOCAL DISENTANGLEMENT ────────────────────────────────────
# LOCAL_ENCODER=True: windowed spatially-local encoder; geometry query k attends
# to a Hilbert-window of blocks around block k. The snap overfit used this with
# LOCAL_WINDOW=1.
LOCAL_ENCODER=True
LOCAL_WINDOW=1
STRUCTURED_LATENT=True             # auto-forced True by LOCAL_ENCODER

# LOCAL_DISENTANGLE off: the snap result did NOT use the z_s global layout
# latent. Leaving it on would add cross_recon + ortho gradients that we did
# not validate at scale. Add as an ablation if needed.
LOCAL_DISENTANGLE=False

SEMANTIC_MODE_OVERRIDE="none"

# Heads & latent disentanglement off (mirrors the validated configuration).
LATENT_DISENTANGLE=False
SEMANTIC_DIMS=512
CROSS_RECON_WEIGHT=0.0
ORTHO_WEIGHT=0.0

COLOR_RESIDUAL=True
MEAN_COLOR_WEIGHT=0.5
COLOR_LOSS_WEIGHT=2.0

STRUCTURED_LAYOUT_TOKENS=False
SCENE_SEMANTIC_HEAD=False
SCENE_SEMANTIC_WEIGHT=0.3
SCENE_LAYOUT_HEAD=False
LAYOUT_LOSS_WEIGHT=0.3
SEMANTIC_TOKEN_HEADS=False

ZS_POOL_INFONCE_WEIGHT=0.0
ZS_POOL_INFONCE_TEMPERATURE=0.10
ZS_LAYOUT_INFONCE_WEIGHT=0.0
ZS_LAYOUT_INFONCE_TEMPERATURE=0.07
ZS_TOKEN_INFONCE_WEIGHT=0.0
ZS_TOKEN_INFONCE_TEMPERATURE=0.07
Z_S_INFONCE_WEIGHT=0.0
Z_S_INFONCE_TEMPERATURE=0.07
Z_S_INFONCE_DELTA=0.4

SEMANTIC_MODE="$SEMANTIC_MODE_OVERRIDE"
SEGMENT_WEIGHT=0.0                  # per-Gaussian InfoNCE off -- not part of snap result
INSTANCE_WEIGHT=0.0
SEMANTIC_TEMP=0.10
SEMANTIC_SUBSAMPLE=10000
SAMPLING_STRATEGY="balanced"

DECODER_FOURIER_PE=True
DECODER_POS_ENC=False

TOKEN_COND=False
TOKEN_COND_APPROACH="B"
TOKEN_COND_ADALN=False

SCALE_PENALTY_WEIGHT=0.0
SCALE_PENALTY_THRESHOLD=0.5

CROP_PERCENTILE=100.0

# ── GAUSSIAN REORDERING (HILBERT) ────────────────────────────────────────────
# REQUIRED. LOCAL_ENCODER and TOKEN_LOCAL_DECODER both assume Hilbert-ordered
# input; the element-wise L2 recon is only learnable when slot i is spatially
# stable across scenes. Same settings as the validated snap overfit.
MORTON_ORDER=True
ORDER_CURVE="hilbert"
ORDER_FRAME_RADIUS=10.0

AUG_YAW=False
AUG_YAW_AXIS="z"
AUG_YAW_MAX_DEG=180.0

# ── SCALE & SCHEDULE ─────────────────────────────────────────────────────────
# Batch 90 is the headroom-validated setting for 4 H100s with TOKEN_LOCAL_DECODER
# and 40k Gaussians. NUM_EPOCHS=500 should give the val L2 floor on this size of
# data (the prior runs at 3000 epochs largely plateaued well before then; with
# 6746 scenes the per-epoch step count is ~75 so 500 epochs ~= 37,500 steps).
BATCH_SIZE=64
NUM_EPOCHS=500
NUM_GAUSSIANS=40000

POS_COND_HEADS=0
POS_COND_COLOR=0
POS_COND_ROTATION=0
POS_COND_SIGMA=6.0
POS_COND_POS_SCALE=10.0

LEARNING_RATE=1e-4
KL_WEIGHT=1e-5
EMBED_DIM=32                         # 512 tokens x 32 = 16384 latent (baseline)
KL_ANNEAL_STEPS=0
LR_RESTART_T0=0                    # 2-3 cosine cycles over 500 epochs is reasonable
EVAL_EVERY=10
WEIGHT_DECAY=1e-2
WARMUP_STEPS=300
LR_MIN_RATIO=0.1
FAILURE_THRESHOLD=100

# ── DATA MIX ────────────────────────────────────────────────────────────────
# Main: 3800 chunks (interior_gs/train_grid... global frame, norm_factor.npy).
# Extra: 800 + 1290 + 906 ~= ~2946 full scenes (per-scene normalised).
# Total ~6746 scenes. Semantics auto-disabled for extras (segment=-1 -> filtered).
TRAIN_SCENES=3800
RANDOM_SUBSET_SEED=""
VAL_SCENES=100
CHUNK_VAL_SCENES=88

SAMPLING_METHOD="opacity"
SAMPLE_VOXEL_RES=96

EXTRA_TRAIN_PATHS="/home/yli7/scratch/datasets/gaussian_world/preprocessed/interior_gs/train:/home/yli7/scratch/datasets/gaussian_world/preprocessed/arkitscenes_mcmc_3dgs/train:/home/yli7/scratch/datasets/gaussian_world/preprocessed/scannetpp_v2_mcmc_3dgs_lang_large_new/train"
EXTRA_TRAIN_SCENES="800:1290:906"

# Preload off: each DDP rank holds its own copy; at ~6746 scenes the RAM ceiling
# is exceeded if preload is on. Slightly slower epochs but stable.
PRELOAD=False

USE_CANONICAL_NORM=True
CHUNK_NORM_FACTOR=True
SCALE_NORM_MODE="linear"

PCA_VIS_FREQ=100
PCA_NUM_SCENES=3
PCA_BRIGHTNESS=1.25
RECON_PLY_FREQ=100
RECON_PLY_NUM_SCENES=3
RECON_PLY_MAX_SH=3

export WANDB_API_KEY="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"
USE_WANDB=True

# ============================================================================
# VALIDATION
# ============================================================================

_any_B=false
[ "$DECODER_LAYOUT_CROSS_ATTN" = "True" ] && _any_B=true
[ "$DECODER_LAYOUT_ADDITIVE"   = "True" ] && _any_B=true

if [ "$SEMANTIC_TOKEN_HEADS" = "True" ] && [ "$LATENT_DISENTANGLE" = "False" ]; then
    echo "ERROR: SEMANTIC_TOKEN_HEADS requires LATENT_DISENTANGLE=True"; exit 1
fi

if [ "$LOCAL_DISENTANGLE" = "True" ] && [ "$LOCAL_ENCODER" != "True" ]; then
    echo "ERROR: LOCAL_DISENTANGLE=True requires LOCAL_ENCODER=True"; exit 1
fi

if [ "$TOKEN_LOCAL_SEPARATE_HEADS" = "True" ] && [ "$TOKEN_LOCAL_DECODER" != "True" ]; then
    echo "ERROR: TOKEN_LOCAL_SEPARATE_HEADS=True requires TOKEN_LOCAL_DECODER=True"; exit 1
fi
if [ "$TOKEN_LOCAL_HEAD_CROSS_STITCH" = "True" ] && [ "$TOKEN_LOCAL_SEPARATE_HEADS" != "True" ]; then
    echo "ERROR: TOKEN_LOCAL_HEAD_CROSS_STITCH=True requires TOKEN_LOCAL_SEPARATE_HEADS=True"
    exit 1
fi

# Canonical voxel sanity checks (mirror the validated config of the overfit).
if [ "$CANONICAL_VOXEL" != "True" ]; then
    echo "══════════════════════════════════════════════════════════════════════"
    echo "  WARNING: CANONICAL_VOXEL is OFF in a job named canvox_snap_scale."
    echo "  This run will NOT reproduce the validated overfit result. Did you"
    echo "  mean to leave it OFF? If so, ignore this warning."
    echo "══════════════════════════════════════════════════════════════════════"
fi
if [ "$CANONICAL_VOXEL" = "True" ] && [ "$VOXEL_SNAP" != "True" ]; then
    echo "══════════════════════════════════════════════════════════════════════"
    echo "  WARNING: CANONICAL_VOXEL=True but VOXEL_SNAP=False."
    echo "  The overfit comparison showed snap=True produces anisotropic shape;"
    echo "  snap=False (residual variant) leaves shape isotropic. If you want"
    echo "  the working configuration set VOXEL_SNAP=True."
    echo "══════════════════════════════════════════════════════════════════════"
fi

if [ "$POSITION_SCAFFOLD" = "True" ] && [ "$SCAFFOLD_MODE" = "hilbert_block" ] && [ "$MORTON_ORDER" != "True" ]; then
    echo "══════════════════════════════════════════════════════════════════════"
    echo "  WARNING: SCAFFOLD_MODE=hilbert_block WITHOUT MORTON_ORDER=True"
    echo "══════════════════════════════════════════════════════════════════════"
fi

if [ "$LOCAL_ENCODER" = "True" ] && [ "$MORTON_ORDER" != "True" ]; then
    echo "══════════════════════════════════════════════════════════════════════"
    echo "  WARNING: LOCAL_ENCODER=True WITHOUT MORTON_ORDER=True"
    echo "══════════════════════════════════════════════════════════════════════"
fi

_CP_CHECK=$(python3 -c "
v = float('$CROP_PERCENTILE')
if v <= 0 or v > 100:
    raise ValueError(f'CROP_PERCENTILE must be in (0, 100], got {v}')
print('ok')
" 2>&1)
if [ "$_CP_CHECK" != "ok" ]; then
    echo "ERROR: CROP_PERCENTILE=$CROP_PERCENTILE is invalid: $_CP_CHECK"
    exit 1
fi

ACTIVE_STRATEGY="C (baseline)"
if [ "$LATENT_DISENTANGLE" = "True" ] && [ "$_any_B" = "false" ]; then
    ACTIVE_STRATEGY="A — 16+496 in sequence (BEST)"
elif [ "$DECODER_LAYOUT_CROSS_ATTN" = "True" ] && [ "$DECODER_LAYOUT_ADDITIVE" = "True" ]; then
    ACTIVE_STRATEGY="B3 — 512 geom + additive + cross-attn"
elif [ "$DECODER_LAYOUT_CROSS_ATTN" = "True" ]; then
    ACTIVE_STRATEGY="B1 — 512 geom + cross-attn per layer"
elif [ "$DECODER_LAYOUT_ADDITIVE" = "True" ]; then
    ACTIVE_STRATEGY="B2 — 512 geom + additive bias"
fi
if [ "$LOCAL_DISENTANGLE" = "True" ]; then
    ACTIVE_STRATEGY="LD — local z_g (512) + global z_s (16, cross-attn)"
fi
if [ "$CANONICAL_VOXEL" = "True" ] && [ "$VOXEL_SNAP" = "True" ]; then
    ACTIVE_STRATEGY="$ACTIVE_STRATEGY  [+canonical-voxel SNAP at R=$VOXEL_RES]"
elif [ "$CANONICAL_VOXEL" = "True" ]; then
    ACTIVE_STRATEGY="$ACTIVE_STRATEGY  [+canonical-voxel RESIDUAL at R=$VOXEL_RES]"
fi

TOKEN_LOCAL_MODE_DESC="SHARED (legacy)"
if [ "$TOKEN_LOCAL_SEPARATE_HEADS" = "True" ]; then
    TOKEN_LOCAL_MODE_DESC="SEPARATE-HEADS"
    [ "$TOKEN_LOCAL_HEAD_CROSS_STITCH" = "True" ] && TOKEN_LOCAL_MODE_DESC="SEPARATE-HEADS + CROSS-STITCH"
fi

echo "========================================================================"
echo "  CAN3TOK — Strategy: $ACTIVE_STRATEGY"
if [ "$TOKEN_LOCAL_DECODER" = "True" ]; then
    echo "  TOKEN-LOCAL DECODER ENABLED  |  mode=$TOKEN_LOCAL_MODE_DESC"
fi
if [ "$LOCAL_DISENTANGLE" = "True" ]; then
    echo "  LOCAL DISENTANGLE: z_s(16) cross-attn | cross_recon=$CROSS_RECON_WEIGHT ortho=$ORTHO_WEIGHT"
fi
_CP_INT=$(python3 -c "print(int(float('$CROP_PERCENTILE')))")
if [ "$_CP_INT" -lt 100 ]; then
    echo "  SPATIAL CROP: keeping inner ${CROP_PERCENTILE}% of each scene"
else
    echo "  Spatial crop    : disabled (CROP_PERCENTILE=100)"
fi
if [ "$MORTON_ORDER" = "True" ]; then
    _FRAME_DESC=$(python3 -c "r=float('$ORDER_FRAME_RADIUS'); print(f'canonical frame [-{r:g},{r:g}]' if r>0 else 'per-scene min-max (legacy)')")
    echo "  GAUSSIAN ORDER  : ${ORDER_CURVE^^} space-filling curve, ${_FRAME_DESC}"
else
    echo "  Gaussian order  : opacity rank (default)"
fi
echo "  Recon objective : element-wise L2 (slot-aligned)"
if [ "$POSITION_SCAFFOLD" = "True" ]; then
    echo "  Position scaffold: ON  mode=$SCAFFOLD_MODE  anchor_relative=$ANCHOR_RELATIVE_DECODE"
else
    echo "  Position scaffold: OFF"
fi
echo "  TRAIN_DATA=$TRAIN_DATA  TRAIN_SCENES=$TRAIN_SCENES  VAL_SCENES=$VAL_SCENES"
if [ "$CANONICAL_VOXEL" = "True" ]; then
    echo "  CANONICAL VOXEL : ON  R=$VOXEL_RES  snap=$VOXEL_SNAP"
    if [ "$VOXEL_SNAP" = "True" ]; then
        echo "  (validated overfit configuration -- this is the scale-up of the working result)"
    fi
else
    echo "  CANONICAL VOXEL : OFF"
fi
echo "========================================================================"
echo ""

# ============================================================================
# ENVIRONMENT
# ============================================================================

module purge && module load 2023 && module load CUDA/12.1.1
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export PATH="/home/yli11/.conda/envs/can3tok/bin:$PATH"
export LD_LIBRARY_PATH="/home/yli11/.conda/envs/can3tok/lib/python3.11/site-packages/torch/lib:$LD_LIBRARY_PATH"

export PYTHONUTF8=1
export LC_ALL=C.UTF-8
export LANG=C.UTF-8

cd /home/yli11/scratch-project/Hafeez_thesis/Semantic-Scene-Completion
mkdir -p logs_ss1 checkpoints_stage1

[ "$USE_WANDB" = "True" ] && wandb login $WANDB_API_KEY --relogin 2>/dev/null

YAML_PATH="./model/configs/aligned_shape_latents/shapevae-256.yaml"
if [ -f "$YAML_PATH" ]; then
    POINT_FEATS=$(grep "point_feats:" "$YAML_PATH" | awk '{print $2}')
    [ "$POINT_FEATS" != "11" ] && echo "ERROR: point_feats=$POINT_FEATS, expected 11" && exit 1
    echo "  point_feats=11 confirmed"
fi

if [ "$TRAIN_DATA" = "chunks" ] || [ "$TRAIN_DATA" = "combined" ]; then
    CHUNKS_DIR="/home/yli7/scratch/datasets/gaussian_world/preprocessed/interior_gs/train_grid1.0cm_chunk8x8_stride6x6"
    echo ""
    echo "  Pre-flight: checking norm_factor.npy in chunk dirs..."

    _NF_COUNT=$(ls "$CHUNKS_DIR" | sort | head -50 | while read d; do
        [ -f "$CHUNKS_DIR/$d/norm_factor.npy" ] && echo "ok"
    done | wc -l)

    if [ "$_NF_COUNT" -eq 50 ]; then
        echo "  norm_factor.npy: 50/50 sampled chunks OK — global frame confirmed"
        _EX_DIR=$(ls "$CHUNKS_DIR" | sort | head -1)
        echo "  Example: $_EX_DIR"
        python3 -c "
import numpy as np, sys
nf = np.load('$CHUNKS_DIR/$_EX_DIR/norm_factor.npy')
print(f'    center=({nf[0]:.3f}, {nf[1]:.3f}, {nf[2]:.3f})  scale={nf[3]:.4f}')
if nf[3] <= 0:
    print('ERROR: scale_factor <= 0 — corrupt norm_factor.npy!')
    sys.exit(1)
"
    elif [ "$_NF_COUNT" -gt 0 ]; then
        echo "  WARNING: norm_factor.npy found in only $_NF_COUNT/50 sampled chunks."
    else
        echo "  ERROR: norm_factor.npy missing from all 50 sampled chunks!"
        exit 1
    fi
    echo ""
fi

echo ""

# ============================================================================
# BUILD COMMAND
# ============================================================================

ACCELERATE_CONFIG="/home/yli11/scratch-project/Hafeez_thesis/Semantic-Scene-Completion/job_scripts/accelerate_config.yaml"
TRAIN_CMD="accelerate launch --config_file $ACCELERATE_CONFIG gs_can3tok_2.py"

TRAIN_CMD="$TRAIN_CMD --train_data $TRAIN_DATA"
TRAIN_CMD="$TRAIN_CMD --batch_size $BATCH_SIZE --num_epochs $NUM_EPOCHS"
TRAIN_CMD="$TRAIN_CMD --num_gaussians $NUM_GAUSSIANS"
if [ "$POS_COND_HEADS" = "1" ]; then
    TRAIN_CMD="$TRAIN_CMD --pos_cond_heads --pos_cond_color $POS_COND_COLOR --pos_cond_rotation $POS_COND_ROTATION"
    TRAIN_CMD="$TRAIN_CMD --pos_cond_sigma $POS_COND_SIGMA --pos_cond_pos_scale $POS_COND_POS_SCALE"
fi
TRAIN_CMD="$TRAIN_CMD --lr $LEARNING_RATE --kl_weight $KL_WEIGHT --kl_anneal_steps $KL_ANNEAL_STEPS"
TRAIN_CMD="$TRAIN_CMD --weight_decay $WEIGHT_DECAY --warmup_steps $WARMUP_STEPS"
TRAIN_CMD="$TRAIN_CMD --lr_min_ratio $LR_MIN_RATIO --lr_restart_T0 $LR_RESTART_T0 --eval_every $EVAL_EVERY"
TRAIN_CMD="$TRAIN_CMD --train_scenes $TRAIN_SCENES --val_scenes $VAL_SCENES"
[ -n "$CHUNK_VAL_SCENES" ] && TRAIN_CMD="$TRAIN_CMD --chunk_val_scenes $CHUNK_VAL_SCENES"
TRAIN_CMD="$TRAIN_CMD --sampling_method $SAMPLING_METHOD"
TRAIN_CMD="$TRAIN_CMD --sample_voxel_res $SAMPLE_VOXEL_RES"

[ "$DECODER_LAYOUT_CROSS_ATTN" = "True" ] && TRAIN_CMD="$TRAIN_CMD --decoder_layout_cross_attn"
[ "$DECODER_LAYOUT_ADDITIVE"   = "True" ] && TRAIN_CMD="$TRAIN_CMD --decoder_layout_additive"

[ "$LATENT_DISENTANGLE" = "True" ] && TRAIN_CMD="$TRAIN_CMD --latent_disentangle"
[ "$LOCAL_DISENTANGLE"  = "True" ] && TRAIN_CMD="$TRAIN_CMD --local_disentangle"
TRAIN_CMD="$TRAIN_CMD --semantic_dims $SEMANTIC_DIMS"
TRAIN_CMD="$TRAIN_CMD --cross_recon_weight $CROSS_RECON_WEIGHT --ortho_weight $ORTHO_WEIGHT"

[ "$COLOR_RESIDUAL" = "True" ] && TRAIN_CMD="$TRAIN_CMD --color_residual"
TRAIN_CMD="$TRAIN_CMD --mean_color_weight $MEAN_COLOR_WEIGHT --color_loss_weight $COLOR_LOSS_WEIGHT"

[ "$SCENE_SEMANTIC_HEAD"      = "True" ] && TRAIN_CMD="$TRAIN_CMD --scene_semantic_head"
TRAIN_CMD="$TRAIN_CMD --scene_semantic_weight $SCENE_SEMANTIC_WEIGHT"
[ "$SCENE_LAYOUT_HEAD"        = "True" ] && TRAIN_CMD="$TRAIN_CMD --scene_layout_head"
[ "$STRUCTURED_LAYOUT_TOKENS" = "True" ] && TRAIN_CMD="$TRAIN_CMD --structured_layout_tokens"
TRAIN_CMD="$TRAIN_CMD --layout_loss_weight $LAYOUT_LOSS_WEIGHT"
[ "$SEMANTIC_TOKEN_HEADS"     = "True" ] && TRAIN_CMD="$TRAIN_CMD --semantic_token_heads"

TRAIN_CMD="$TRAIN_CMD --zs_pool_infonce_weight $ZS_POOL_INFONCE_WEIGHT"
TRAIN_CMD="$TRAIN_CMD --zs_pool_infonce_temperature $ZS_POOL_INFONCE_TEMPERATURE"
TRAIN_CMD="$TRAIN_CMD --zs_layout_infonce_weight $ZS_LAYOUT_INFONCE_WEIGHT"
TRAIN_CMD="$TRAIN_CMD --zs_layout_infonce_temperature $ZS_LAYOUT_INFONCE_TEMPERATURE"
TRAIN_CMD="$TRAIN_CMD --zs_token_infonce_weight $ZS_TOKEN_INFONCE_WEIGHT"
TRAIN_CMD="$TRAIN_CMD --zs_token_infonce_temperature $ZS_TOKEN_INFONCE_TEMPERATURE"
TRAIN_CMD="$TRAIN_CMD --z_s_infonce_weight $Z_S_INFONCE_WEIGHT"
TRAIN_CMD="$TRAIN_CMD --z_s_infonce_temperature $Z_S_INFONCE_TEMPERATURE"
TRAIN_CMD="$TRAIN_CMD --z_s_infonce_delta $Z_S_INFONCE_DELTA"

TRAIN_CMD="$TRAIN_CMD --semantic_mode $SEMANTIC_MODE"
TRAIN_CMD="$TRAIN_CMD --segment_loss_weight $SEGMENT_WEIGHT"
TRAIN_CMD="$TRAIN_CMD --instance_loss_weight $INSTANCE_WEIGHT"
TRAIN_CMD="$TRAIN_CMD --semantic_temperature $SEMANTIC_TEMP"
TRAIN_CMD="$TRAIN_CMD --semantic_subsample $SEMANTIC_SUBSAMPLE"
TRAIN_CMD="$TRAIN_CMD --sampling_strategy $SAMPLING_STRATEGY"

[ "$DECODER_POS_ENC"    = "True" ] && TRAIN_CMD="$TRAIN_CMD --decoder_pos_enc"
[ "$DECODER_FOURIER_PE" = "True" ] && TRAIN_CMD="$TRAIN_CMD --decoder_fourier_pe"
[ "$TOKEN_LOCAL_DECODER" = "True" ] && TRAIN_CMD="$TRAIN_CMD --token_local_decoder"
[ "$TOKEN_LOCAL_SEPARATE_HEADS"    = "True" ] && TRAIN_CMD="$TRAIN_CMD --token_local_separate_heads"
[ "$TOKEN_LOCAL_HEAD_CROSS_STITCH" = "True" ] && TRAIN_CMD="$TRAIN_CMD --token_local_head_cross_stitch"

[ "$POSITION_SCAFFOLD" = "True" ] && TRAIN_CMD="$TRAIN_CMD --position_scaffold --anchor_loss_weight $ANCHOR_LOSS_WEIGHT"
TRAIN_CMD="$TRAIN_CMD --scaffold_mode $SCAFFOLD_MODE"
[ "$ANCHOR_RELATIVE_DECODE" = "True" ] && TRAIN_CMD="$TRAIN_CMD --anchor_relative_decode --offset_scale_init $OFFSET_SCALE_INIT"
[ "$ANCHOR_TEACHER_FORCE" = "True" ] && TRAIN_CMD="$TRAIN_CMD --anchor_teacher_force"
[ "$STRUCTURED_LATENT" = "True" ] && TRAIN_CMD="$TRAIN_CMD --structured_latent"
[ "$LOCAL_ENCODER" = "True" ] && TRAIN_CMD="$TRAIN_CMD --local_encoder --local_window $LOCAL_WINDOW"

[ "$TOKEN_COND"       = "True" ] && TRAIN_CMD="$TRAIN_CMD --token_cond --token_cond_approach $TOKEN_COND_APPROACH"
[ "$TOKEN_COND_ADALN" = "True" ] && TRAIN_CMD="$TRAIN_CMD --token_cond_adaln"

TRAIN_CMD="$TRAIN_CMD --scale_penalty_weight $SCALE_PENALTY_WEIGHT"
TRAIN_CMD="$TRAIN_CMD --scale_penalty_threshold $SCALE_PENALTY_THRESHOLD"

TRAIN_CMD="$TRAIN_CMD --scale_norm_mode $SCALE_NORM_MODE"
[ "$USE_CANONICAL_NORM"  = "False" ] && TRAIN_CMD="$TRAIN_CMD --no_canonical_norm"
[ "$CHUNK_NORM_FACTOR"   = "False" ] && TRAIN_CMD="$TRAIN_CMD --no_chunk_norm_factor"

TRAIN_CMD="$TRAIN_CMD --pca_vis_freq $PCA_VIS_FREQ --pca_num_scenes $PCA_NUM_SCENES"
TRAIN_CMD="$TRAIN_CMD --pca_brightness $PCA_BRIGHTNESS"
TRAIN_CMD="$TRAIN_CMD --recon_ply_freq $RECON_PLY_FREQ --recon_ply_num_scenes $RECON_PLY_NUM_SCENES"
TRAIN_CMD="$TRAIN_CMD --recon_ply_max_sh $RECON_PLY_MAX_SH"

[ "$USE_WANDB" = "True" ] && TRAIN_CMD="$TRAIN_CMD --use_wandb --wandb_project Can3Tok-SceenSplat-7K --wandb_entity 3D-SSC"

[ -n "$RANDOM_SUBSET_SEED" ] && TRAIN_CMD="$TRAIN_CMD --random_subset_seed $RANDOM_SUBSET_SEED"

TRAIN_CMD="$TRAIN_CMD --crop_percentile $CROP_PERCENTILE"

[ "$MORTON_ORDER" = "True" ] && TRAIN_CMD="$TRAIN_CMD --morton_order"
TRAIN_CMD="$TRAIN_CMD --order_curve $ORDER_CURVE"
TRAIN_CMD="$TRAIN_CMD --order_frame_radius $ORDER_FRAME_RADIUS"

# ── CANONICAL VOXEL FLAGS ────────────────────────────────────────────────────
[ "$CANONICAL_VOXEL" = "True" ] && TRAIN_CMD="$TRAIN_CMD --canonical_voxel --voxel_res $VOXEL_RES"
[ "$VOXEL_SNAP" = "True" ] && TRAIN_CMD="$TRAIN_CMD --voxel_snap"

[ -n "$EMBED_DIM" ] && TRAIN_CMD="$TRAIN_CMD --embed_dim $EMBED_DIM"

[ "$AUG_YAW" = "True" ] && TRAIN_CMD="$TRAIN_CMD --aug_yaw --aug_yaw_axis $AUG_YAW_AXIS --aug_yaw_max_deg $AUG_YAW_MAX_DEG"

if [ -n "$RESUME_CHECKPOINT" ]; then
    TRAIN_CMD="$TRAIN_CMD --resume_checkpoint $RESUME_CHECKPOINT"
    [ -n "$RESUME_EPOCH" ] && TRAIN_CMD="$TRAIN_CMD --resume_epoch $RESUME_EPOCH"
fi

[ -n "$EXTRA_TRAIN_PATHS"  ] && TRAIN_CMD="$TRAIN_CMD --extra_train_paths $EXTRA_TRAIN_PATHS"
[ -n "$EXTRA_TRAIN_SCENES" ] && TRAIN_CMD="$TRAIN_CMD --extra_train_scenes $EXTRA_TRAIN_SCENES"
[ "$PRELOAD" = "False" ] && TRAIN_CMD="$TRAIN_CMD --no_preload"

echo "Command: $TRAIN_CMD"
echo ""

# ============================================================================
# RUN
# ============================================================================

SECONDS=0
eval $TRAIN_CMD
TRAIN_EXIT=$?
echo ""
echo "Exit: $TRAIN_EXIT  |  Duration: $((SECONDS/60))m $((SECONDS%60))s  |  End: $(date)"

if [ $TRAIN_EXIT -eq 0 ]; then
    echo ""
    echo "COMPLETED. Strategy: $ACTIVE_STRATEGY | TokenLocal: $TOKEN_LOCAL_MODE_DESC | Data: $TRAIN_DATA + extras | CanonicalVoxel: R=${VOXEL_RES}, snap=${VOXEL_SNAP}"
    echo ""
    echo "  Useful log greps:"
    echo "  Best full-scene model  : grep 'NEW BEST' logs_ss1/can3tok_canvox_snap_scale_${SLURM_JOB_ID}.out | tail -5"
    echo "  Val full scenes (L2)   : grep 'Val FULL SCENES' logs_ss1/can3tok_canvox_snap_scale_${SLURM_JOB_ID}.out"
    echo "  Rotation convergence   : grep 'Rot=' logs_ss1/can3tok_canvox_snap_scale_${SLURM_JOB_ID}.out | tail -20"
    echo "  Scale convergence      : grep 'Scl=' logs_ss1/can3tok_canvox_snap_scale_${SLURM_JOB_ID}.out | tail -20"
    echo "  Position convergence   : grep 'Pos=' logs_ss1/can3tok_canvox_snap_scale_${SLURM_JOB_ID}.out | tail -20"
    echo "  Gaussian order         : grep 'GAUSSIAN ORDER' logs_ss1/can3tok_canvox_snap_scale_${SLURM_JOB_ID}.out"
    echo "  TokenLocalDecoder mode : grep 'TokenLocalDecoder' logs_ss1/can3tok_canvox_snap_scale_${SLURM_JOB_ID}.out"
    echo "  Canonical voxel        : grep 'CANONICAL VOXEL' logs_ss1/can3tok_canvox_snap_scale_${SLURM_JOB_ID}.out"
    echo ""
    echo "  CRITICAL: Rot=... should drop well below the ~570 random-init floor"
    echo "  that all pre-canonical-voxel runs hit. In the overfit, Rot dropped"
    echo "  from ~570 to ~70 on train. At scale with held-out validation, expect"
    echo "  Val Rot to drop substantially below 570 -- though the absolute floor"
    echo "  at scale will be higher than the overfit number because the train"
    echo "  set is larger (less memorization) and we have real generalization."
    echo ""
    echo "  Recon PLY visualizations every $RECON_PLY_FREQ epochs at:"
    echo "    checkpoints_stage1/RGB_job_${SLURM_JOB_ID}_*/reconstructed_gaussians/epoch_*/"
    echo "  Check epoch_${NUM_EPOCHS} or the best_model PLY (whichever is later)"
    echo "  for anisotropic, surface-aligned Gaussians at the validated quality."
else
    echo "FAILED (exit $TRAIN_EXIT)"
    echo "  Error log: cat logs_ss1/can3tok_canvox_snap_scale_${SLURM_JOB_ID}.err"
fi
