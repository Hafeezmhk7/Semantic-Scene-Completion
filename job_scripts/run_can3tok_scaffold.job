#!/bin/bash
#SBATCH --job-name=can3tok
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --time=20:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=6
#SBATCH --mem=80G
#SBATCH --output=logs/can3tok_%j.out
#SBATCH --error=logs/can3tok_%j.err


# cpus per task:9 for h100
# mem 128G
# ============================================================================
# CAN3TOK — INFERENCE-FIXED + OFFSET SUPERVISION + SCALE PENALTY
# ============================================================================
#
# CHANGES IN THIS VERSION:
#
#   1. AnchorPredFromTokens (inference fix):
#      transformer_tokens -> predicted_anchors [B,512,3] inside decode()
#      DC added to decoder positions -> output is absolute positions
#      scaffold_token_ids=None at inference -> fixed j->j*512//40000
#
#   2. Offset supervision for position:
#      Training target: OFFSETS (coord - GT_hard_anchor, range ~+-2m)
#      L_recon and L_anchor are fully orthogonal (no overlap on DC term)
#      PLY save: decoder output is already absolute, no post-processing needed
#
#   3. Cross-recon fix:
#      decode() always outputs absolute positions (DC added inside)
#      cross_recon now correctly uses target_abs for position
#      CrossRecon will be numerically larger than before (was artificially
#      small due to 5x scale mismatch). It will decrease as anchors converge.
#
#   4. Scale penalty (NEW):
#      Penalises Gaussians with post-exp scale > SCALE_PENALTY_THRESHOLD (m)
#      penalty = mean(clamp(scale - threshold, 0)^2)
#      Set SCALE_PENALTY_WEIGHT=0.0 to disable (default, backward-compatible)
#      Safe to add to any pre-trained checkpoint for fine-tuning
#
# ABLATION HISTORY:
#  Run | color | sem | scaf | disent | layout | PE | tc  | scale_pen | Result
#  ----|-------|-----|------|--------|--------|----|-----|-----------|-------
#  A   |  v    |     |      |        |        |    |     |           | L2=1.43
#  H   |  v    | v   |      |   v    |   v    |    |     |           | L2=1.565
#  K   |  v    | v   |      |   v    |   v    |    |     |           | L2~1.0-1.2
#  P   |  v    | v   |      |   v    |   v    | v  |     |           | L2=1.38
#  R   |  v    | v   | v    |   v    |   v    | v  | A   |           | L2=0.589
#  T2  |  v    | v   | v    |   v    |   v    | v  | AB  |           | L2=0.606
#  V   |  v    | v   | v    |   v    |   v    | v  | AB  |           | offset fix
#  W   |  v    | v   | v    |   v    |   v    | v  | AB  | 0.1/0.5m  | <- THIS
# ============================================================================

echo "Job ID: $SLURM_JOB_ID  |  Node: $SLURM_NODELIST  |  Start: $(date)"

# ============================================================================
# FLAGS — EDIT THIS SECTION ONLY
# ============================================================================

# ── Checkpoint resuming ───────────────────────────────────────────────────────
# To fine-tune an existing 2k-epoch checkpoint with scale penalty:
#   RESUME_CHECKPOINT="/path/to/best_model.pth"
#   RESUME_EPOCH=0        # reset counter for clean 200-epoch fine-tune run
#   NUM_EPOCHS=200
#   SCALE_PENALTY_WEIGHT=0.1
RESUME_CHECKPOINT=""
RESUME_EPOCH=""

# ── Core contributions ────────────────────────────────────────────────────────
COLOR_RESIDUAL=True
MEAN_COLOR_WEIGHT=1.0
COLOR_LOSS_WEIGHT=1.0
SCENE_SEMANTIC_HEAD=True
SCENE_SEMANTIC_WEIGHT=0.3

# ── Position scaffold ─────────────────────────────────────────────────────────
# Must be True for AnchorPredFromTokens to activate.
# Offset supervision is applied automatically when True.
POSITION_SCAFFOLD=True
ANCHOR_LOSS_WEIGHT=1.0

# ── Decoder shape conditioning ────────────────────────────────────────────────
DECODER_SHAPE_PREPEND=False
DECODER_SHAPE_CROSS_ATTN=False
DECODER_CROSS_ATTN_LAYERS=6

# ── InfoNCE ───────────────────────────────────────────────────────────────────
SEMANTIC_MODE="none"
SEGMENT_WEIGHT=0.0
INSTANCE_WEIGHT=0.0
SEMANTIC_TEMP=0.07
SEMANTIC_SUBSAMPLE=10000
SAMPLING_STRATEGY="balanced"

# ── Latent disentanglement ────────────────────────────────────────────────────
LATENT_DISENTANGLE=True
SEMANTIC_DIMS=512
CROSS_RECON_WEIGHT=0.5
ORTHO_WEIGHT=0.1

# ── Scene layout head ─────────────────────────────────────────────────────────
SCENE_LAYOUT_HEAD=True
LAYOUT_LOSS_WEIGHT=0.3

# ── Position layout residual ──────────────────────────────────────────────────
# Must be False when POSITION_SCAFFOLD=True (mutually exclusive)
POSITION_LAYOUT_RESIDUAL=False

# ── JEPA Idea 1 ───────────────────────────────────────────────────────────────
JEPA_IDEA1=False
JEPA_IDEA1_WEIGHT=1.0

# ── Idea 0: Decoder positional encoding ──────────────────────────────────────
DECODER_POS_ENC=True

# ── Idea 1: Segment label prediction ─────────────────────────────────────────
PREDICT_SEG_LABELS=False
SEG_PRED_WEIGHT=0.3

# ── Idea 2: Token centroid conditioning ──────────────────────────────────────
TOKEN_COND=True
TOKEN_COND_APPROACH="B"

# ── Idea 3: Query decoder ────────────────────────────────────────────────────
QUERY_DECODER=False

# ── SCALE PENALTY ─────────────────────────────────────────────────────────────
# Penalises post-exp scale values above the threshold (metres).
# Formula: mean(clamp(scale - threshold, 0)^2) weighted by SCALE_PENALTY_WEIGHT
#
# SCALE_PENALTY_WEIGHT guide:
#   0.0  = disabled, no change to training (default, backward-compatible)
#   0.05 = gentle nudge — good starting point if scale is only slightly high
#   0.1  = recommended for fine-tuning a trained checkpoint with Scl > 10
#   0.2  = aggressive — use only if Scl is very large (>50) and other losses stable
#
# SCALE_PENALTY_THRESHOLD guide (metres):
#   0.5  = 50cm — permissive, only penalises clearly bloated Gaussians
#   0.3  = 30cm — recommended for indoor SceneSplat scenes
#   0.2  = 20cm — strict, use if you want very compact Gaussians
#
# Check batch-0 diagnostic in log:
#   [SCALE PENALTY] frac above threshold: XX.X%
#   If >50%: start with weight=0.05 to avoid disrupting other losses
#   If <20%: weight=0.1 or 0.2 is safe
SCALE_PENALTY_WEIGHT=0.0
SCALE_PENALTY_THRESHOLD=0.5

# ── Core training ─────────────────────────────────────────────────────────────
BATCH_SIZE=100   # max 115 on h100
NUM_EPOCHS=3000
LEARNING_RATE=1e-4
KL_WEIGHT=1e-6
EVAL_EVERY=50
FAILURE_THRESHOLD=100

# ── LR scheduler ──────────────────────────────────────────────────────────────
WEIGHT_DECAY=1e-2
WARMUP_STEPS=500
LR_MIN_RATIO=0.1

# ── Dataset ───────────────────────────────────────────────────────────────────
TRAIN_SCENES=300
VAL_SCENES=50
SAMPLING_METHOD="opacity"

# ── Normalisation ─────────────────────────────────────────────────────────────
USE_CANONICAL_NORM=True
SCALE_NORM_MODE="linear"

# ── Visualisation ─────────────────────────────────────────────────────────────
PCA_VIS_FREQ=500
PCA_NUM_SCENES=3
PCA_BRIGHTNESS=1.25
RECON_PLY_FREQ=50
RECON_PLY_NUM_SCENES=3
RECON_PLY_MAX_SH=3

# ── W&B ───────────────────────────────────────────────────────────────────────
export WANDB_API_KEY="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"
USE_WANDB=False

# ============================================================================
# VALIDATION
# ============================================================================

if [ "$TOKEN_COND" = "True" ] && echo "$TOKEN_COND_APPROACH" | grep -q "A"; then
    if [ "$POSITION_SCAFFOLD" = "False" ]; then
        echo "[INFO] TOKEN_COND approach A requires POSITION_SCAFFOLD. Enabling."
        POSITION_SCAFFOLD=True
    fi
    if [ "$POSITION_LAYOUT_RESIDUAL" = "True" ]; then
        echo "[INFO] TOKEN_COND approach A uses scaffold. Disabling POSITION_LAYOUT_RESIDUAL."
        POSITION_LAYOUT_RESIDUAL=False
    fi
fi

if [ "$QUERY_DECODER" = "True" ]; then
    if [ "$POSITION_SCAFFOLD" = "False" ]; then
        echo "[INFO] QUERY_DECODER requires POSITION_SCAFFOLD. Enabling."
        POSITION_SCAFFOLD=True
    fi
    if [ "$POSITION_LAYOUT_RESIDUAL" = "True" ]; then
        echo "[INFO] QUERY_DECODER uses scaffold. Disabling POSITION_LAYOUT_RESIDUAL."
        POSITION_LAYOUT_RESIDUAL=False
    fi
fi

if [ "$POSITION_SCAFFOLD" = "True" ] && [ "$POSITION_LAYOUT_RESIDUAL" = "True" ]; then
    echo "ERROR: POSITION_SCAFFOLD and POSITION_LAYOUT_RESIDUAL are mutually exclusive."
    exit 1
fi

echo "========================================================================"
echo "  CAN3TOK — Run W (offset supervision + cross-recon fix + scale penalty)"
echo "========================================================================"
echo ""
echo "  Contributions active:"
echo "    color_residual=$COLOR_RESIDUAL | scene_semantic=$SCENE_SEMANTIC_HEAD"
echo "    position_scaffold=$POSITION_SCAFFOLD (OFFSET supervision ~+-2m)"
echo "    anchor_loss_weight=$ANCHOR_LOSS_WEIGHT"
echo "    latent_disentangle=$LATENT_DISENTANGLE (dims=$SEMANTIC_DIMS)"
echo "    scene_layout_head=$SCENE_LAYOUT_HEAD"
echo "    decoder_pos_enc=$DECODER_POS_ENC"
echo "    token_cond=$TOKEN_COND approach=$TOKEN_COND_APPROACH"
echo ""
echo "  Scale penalty:"
if [ "$SCALE_PENALTY_WEIGHT" = "0.0" ] || [ "$SCALE_PENALTY_WEIGHT" = "0" ]; then
    echo "    DISABLED (SCALE_PENALTY_WEIGHT=0)"
else
    echo "    weight=$SCALE_PENALTY_WEIGHT  threshold=${SCALE_PENALTY_THRESHOLD}m  ACTIVE"
fi
echo ""
echo "  LR: peak=$LEARNING_RATE | floor=1e-5 | warmup=$WARMUP_STEPS"
echo "  Dataset: $TRAIN_SCENES train, $VAL_SCENES val | BS=$BATCH_SIZE | epochs=$NUM_EPOCHS"
echo "========================================================================"
echo ""

# ============================================================================
# ENVIRONMENT
# ============================================================================

module purge && module load 2023 && module load CUDA/12.1.1
export PATH="/home/yli11/.conda/envs/can3tok/bin:$PATH"
export LD_LIBRARY_PATH="/home/yli11/.conda/envs/can3tok/lib/python3.11/\
site-packages/torch/lib:$LD_LIBRARY_PATH"

cd /home/yli11/scratch/Hafeez_thesis/Can3Tok
mkdir -p logs checkpoints

if [ "$USE_WANDB" = "True" ]; then
    wandb login $WANDB_API_KEY --relogin 2>/dev/null
fi

YAML_PATH="./model/configs/aligned_shape_latents/shapevae-256.yaml"
if [ -f "$YAML_PATH" ]; then
    POINT_FEATS=$(grep "point_feats:" "$YAML_PATH" | awk '{print $2}')
    if [ "$POINT_FEATS" != "11" ]; then
        echo "ERROR: point_feats=$POINT_FEATS, expected 11"; exit 1
    fi
    echo "  point_feats=11 confirmed"
fi
echo ""

# ============================================================================
# BUILD TRAINING COMMAND
# ============================================================================

TRAIN_CMD="python gs_can3tok_2.py"
TRAIN_CMD="$TRAIN_CMD --batch_size $BATCH_SIZE"
TRAIN_CMD="$TRAIN_CMD --num_epochs $NUM_EPOCHS"
TRAIN_CMD="$TRAIN_CMD --lr $LEARNING_RATE"
TRAIN_CMD="$TRAIN_CMD --kl_weight $KL_WEIGHT"
TRAIN_CMD="$TRAIN_CMD --weight_decay $WEIGHT_DECAY"
TRAIN_CMD="$TRAIN_CMD --warmup_steps $WARMUP_STEPS"
TRAIN_CMD="$TRAIN_CMD --lr_min_ratio $LR_MIN_RATIO"
TRAIN_CMD="$TRAIN_CMD --eval_every $EVAL_EVERY"
TRAIN_CMD="$TRAIN_CMD --failure_threshold $FAILURE_THRESHOLD"
TRAIN_CMD="$TRAIN_CMD --train_scenes $TRAIN_SCENES"
TRAIN_CMD="$TRAIN_CMD --val_scenes $VAL_SCENES"
TRAIN_CMD="$TRAIN_CMD --sampling_method $SAMPLING_METHOD"

[ "$COLOR_RESIDUAL"           = "True" ] && TRAIN_CMD="$TRAIN_CMD --color_residual"
TRAIN_CMD="$TRAIN_CMD --mean_color_weight $MEAN_COLOR_WEIGHT"
TRAIN_CMD="$TRAIN_CMD --color_loss_weight $COLOR_LOSS_WEIGHT"

[ "$SCENE_SEMANTIC_HEAD"      = "True" ] && TRAIN_CMD="$TRAIN_CMD --scene_semantic_head"
TRAIN_CMD="$TRAIN_CMD --scene_semantic_weight $SCENE_SEMANTIC_WEIGHT"

[ "$POSITION_SCAFFOLD"        = "True" ] && TRAIN_CMD="$TRAIN_CMD --position_scaffold"
TRAIN_CMD="$TRAIN_CMD --anchor_loss_weight $ANCHOR_LOSS_WEIGHT"

[ "$DECODER_SHAPE_PREPEND"    = "True" ] && TRAIN_CMD="$TRAIN_CMD --decoder_shape_prepend"
[ "$DECODER_SHAPE_CROSS_ATTN" = "True" ] && TRAIN_CMD="$TRAIN_CMD --decoder_shape_cross_attn"
TRAIN_CMD="$TRAIN_CMD --decoder_cross_attn_layers $DECODER_CROSS_ATTN_LAYERS"

TRAIN_CMD="$TRAIN_CMD --semantic_mode $SEMANTIC_MODE"
TRAIN_CMD="$TRAIN_CMD --segment_loss_weight $SEGMENT_WEIGHT"
TRAIN_CMD="$TRAIN_CMD --instance_loss_weight $INSTANCE_WEIGHT"
TRAIN_CMD="$TRAIN_CMD --semantic_temperature $SEMANTIC_TEMP"
TRAIN_CMD="$TRAIN_CMD --semantic_subsample $SEMANTIC_SUBSAMPLE"
TRAIN_CMD="$TRAIN_CMD --sampling_strategy $SAMPLING_STRATEGY"

[ "$LATENT_DISENTANGLE"       = "True" ] && TRAIN_CMD="$TRAIN_CMD --latent_disentangle"
TRAIN_CMD="$TRAIN_CMD --semantic_dims $SEMANTIC_DIMS"
TRAIN_CMD="$TRAIN_CMD --cross_recon_weight $CROSS_RECON_WEIGHT"
TRAIN_CMD="$TRAIN_CMD --ortho_weight $ORTHO_WEIGHT"

[ "$SCENE_LAYOUT_HEAD"        = "True" ] && TRAIN_CMD="$TRAIN_CMD --scene_layout_head"
TRAIN_CMD="$TRAIN_CMD --layout_loss_weight $LAYOUT_LOSS_WEIGHT"
[ "$POSITION_LAYOUT_RESIDUAL" = "True" ] && TRAIN_CMD="$TRAIN_CMD --position_layout_residual"

[ "$JEPA_IDEA1"               = "True" ] && TRAIN_CMD="$TRAIN_CMD --jepa_idea1"
TRAIN_CMD="$TRAIN_CMD --jepa_idea1_weight $JEPA_IDEA1_WEIGHT"

[ "$DECODER_POS_ENC"          = "True" ] && TRAIN_CMD="$TRAIN_CMD --decoder_pos_enc"
[ "$PREDICT_SEG_LABELS"       = "True" ] && TRAIN_CMD="$TRAIN_CMD --predict_seg_labels"
TRAIN_CMD="$TRAIN_CMD --seg_pred_weight $SEG_PRED_WEIGHT"
[ "$TOKEN_COND"               = "True" ] && TRAIN_CMD="$TRAIN_CMD --token_cond"
[ "$TOKEN_COND"               = "True" ] && TRAIN_CMD="$TRAIN_CMD --token_cond_approach $TOKEN_COND_APPROACH"
[ "$QUERY_DECODER"            = "True" ] && TRAIN_CMD="$TRAIN_CMD --query_decoder"

# Scale penalty flags (always passed — 0.0 means disabled)
TRAIN_CMD="$TRAIN_CMD --scale_penalty_weight $SCALE_PENALTY_WEIGHT"
TRAIN_CMD="$TRAIN_CMD --scale_penalty_threshold $SCALE_PENALTY_THRESHOLD"

TRAIN_CMD="$TRAIN_CMD --scale_norm_mode $SCALE_NORM_MODE"
[ "$USE_CANONICAL_NORM"       = "False" ] && TRAIN_CMD="$TRAIN_CMD --no_canonical_norm"

TRAIN_CMD="$TRAIN_CMD --pca_vis_freq $PCA_VIS_FREQ"
TRAIN_CMD="$TRAIN_CMD --pca_num_scenes $PCA_NUM_SCENES"
TRAIN_CMD="$TRAIN_CMD --pca_brightness $PCA_BRIGHTNESS"
TRAIN_CMD="$TRAIN_CMD --recon_ply_freq $RECON_PLY_FREQ"
TRAIN_CMD="$TRAIN_CMD --recon_ply_num_scenes $RECON_PLY_NUM_SCENES"
TRAIN_CMD="$TRAIN_CMD --recon_ply_max_sh $RECON_PLY_MAX_SH"

if [ "$USE_WANDB" = "True" ]; then
    TRAIN_CMD="$TRAIN_CMD --use_wandb"
    TRAIN_CMD="$TRAIN_CMD --wandb_project Can3Tok-SceenSplat-7K"
    TRAIN_CMD="$TRAIN_CMD --wandb_entity 3D-SSC"
fi

if [ -n "$RESUME_CHECKPOINT" ]; then
    TRAIN_CMD="$TRAIN_CMD --resume_checkpoint $RESUME_CHECKPOINT"
    [ -n "$RESUME_EPOCH" ] && TRAIN_CMD="$TRAIN_CMD --resume_epoch $RESUME_EPOCH"
fi

echo "Command: $TRAIN_CMD"
echo ""

# ============================================================================
# RUN
# ============================================================================

SECONDS=0
eval $TRAIN_CMD
TRAIN_EXIT=$?
echo ""
echo "Exit: $TRAIN_EXIT  |  Duration: $((SECONDS/60))m $((SECONDS%60))s  |  End: $(date)"

# ============================================================================
# POST-RUN DIAGNOSTICS
# ============================================================================

if [ $TRAIN_EXIT -eq 0 ]; then
    echo ""
    echo "COMPLETED. Key diagnostics:"
    echo ""
    echo "  1. Scale penalty convergence:"
    echo "     grep 'ScalePenalty' logs/can3tok_${SLURM_JOB_ID}.out | head -20"
    echo "     ScalePenalty should decrease; Scl= should drop from ~62 toward ~5-10"
    echo "     If position/rotation spikes: reduce SCALE_PENALTY_WEIGHT (try 0.05)"
    echo ""
    echo "  2. Batch-0 scale diagnostic:"
    echo "     grep 'SCALE PENALTY' logs/can3tok_${SLURM_JOB_ID}.out | head -5"
    echo "     Shows mean/max scale and fraction above threshold at epoch start"
    echo ""
    echo "  3. Offset supervision check:"
    echo "     grep 'OFFSET SUPERVISION' logs/can3tok_${SLURM_JOB_ID}.out | head -5"
    echo "     GT offset range should be ~+-2m (5x smaller than absolute +-10m)"
    echo ""
    echo "  4. AnchorPredFromTokens convergence:"
    echo "     grep 'AnchorMSE' logs/can3tok_${SLURM_JOB_ID}.out | head -20"
    echo "     Should fall from ~4-8m at init toward ~0.5-1m"
    echo ""
    echo "  5. Cross-recon (after fix):"
    echo "     grep 'CrossRecon' logs/can3tok_${SLURM_JOB_ID}.out | head -20"
    echo "     Numerically larger than before (was artificially small) but trending down"
    echo ""
    echo "  6. Best L2:"
    echo "     grep 'NEW BEST' logs/can3tok_${SLURM_JOB_ID}.out | tail -5"
else
    echo ""
    echo "FAILED (exit $TRAIN_EXIT)"
    echo "  Common causes:"
    echo "    POSITION_SCAFFOLD and POSITION_LAYOUT_RESIDUAL both True -> mutually exclusive"
    echo "    TOKEN_COND approach A without POSITION_SCAFFOLD -> enable scaffold"
    echo "    TOKEN_COND approach B without SCENE_LAYOUT_HEAD -> enable layout head"
    echo "    OOM with QUERY_DECODER -> reduce BATCH_SIZE to 32"
    echo "  Error log: cat logs/can3tok_${SLURM_JOB_ID}.err"
fi
