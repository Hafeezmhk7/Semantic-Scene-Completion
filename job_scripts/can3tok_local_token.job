#!/bin/bash
#SBATCH --job-name=can3tok_tokenlocal
#SBATCH --partition=gpu_h100
#SBATCH --gpus=2
#SBATCH --time=10:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --mem=90G
#SBATCH --output=logs_ss1/can3tok_chunks_10k_ht_%j.out
#SBATCH --error=logs_ss1/can3tok_chunks_10k_ht_%j.err

echo "Job ID: $SLURM_JOB_ID  |  Node: $SLURM_NODELIST  |  Start: $(date)"

# ============================================================================
# DATASET SELECTION
# ============================================================================
# CLEAN CHUNK SPLIT: train on the first 3800 sorted chunks, hold out the remaining
# 88 for validation (3888 total). The split is disjoint by construction and the
# training script hard-fails if it is not (see the contamination guard).
TRAIN_DATA="chunks"

# ============================================================================
# FLAGS
# ============================================================================

RESUME_CHECKPOINT=""
RESUME_EPOCH=""

DECODER_LAYOUT_CROSS_ATTN=False
DECODER_LAYOUT_ADDITIVE=False

TOKEN_LOCAL_DECODER=False

SEMANTIC_MODE_OVERRIDE="none"

LATENT_DISENTANGLE=True
SEMANTIC_DIMS=512
CROSS_RECON_WEIGHT=0.3
ORTHO_WEIGHT=0.1

COLOR_RESIDUAL=True
MEAN_COLOR_WEIGHT=0.5
COLOR_LOSS_WEIGHT=2.0

STRUCTURED_LAYOUT_TOKENS=False

SCENE_SEMANTIC_HEAD=False
SCENE_SEMANTIC_WEIGHT=0.3
SCENE_LAYOUT_HEAD=False
LAYOUT_LOSS_WEIGHT=0.3
SEMANTIC_TOKEN_HEADS=False

ZS_POOL_INFONCE_WEIGHT=0.0
ZS_POOL_INFONCE_TEMPERATURE=0.10

ZS_LAYOUT_INFONCE_WEIGHT=0.0
ZS_LAYOUT_INFONCE_TEMPERATURE=0.07
ZS_TOKEN_INFONCE_WEIGHT=0.0
ZS_TOKEN_INFONCE_TEMPERATURE=0.07
Z_S_INFONCE_WEIGHT=0.0
Z_S_INFONCE_TEMPERATURE=0.07
Z_S_INFONCE_DELTA=0.4

SEMANTIC_MODE="$SEMANTIC_MODE_OVERRIDE"
SEGMENT_WEIGHT=0.0
INSTANCE_WEIGHT=0.0
SEMANTIC_TEMP=0.10
SEMANTIC_SUBSAMPLE=10000
SAMPLING_STRATEGY="balanced"

DECODER_FOURIER_PE=True
DECODER_POS_ENC=False

TOKEN_COND=False
TOKEN_COND_APPROACH="B"
TOKEN_COND_ADALN=False

SCALE_PENALTY_WEIGHT=0.0
SCALE_PENALTY_THRESHOLD=0.5

# ── Spatial crop ──────────────────────────────────────────────────────────────
# Keep inner CROP_PERCENTILE% of each scene by distance from centroid before
# opacity sampling. 100.0 = disabled. 50.0 = keep inner half.
#
# NOTE on isolating the ORDERING fix below: to see the Morton effect cleanly,
# set CROP_PERCENTILE=100.0 (disable crop) so the only change vs the failing run
# is the Gaussian ordering. Mixing crop + morton changes two variables at once.
CROP_PERCENTILE=100.0   # set to 50.0 to re-enable cropping

# ── Gaussian ordering (MORTON / Z-ORDER) ──────────────────────────────────────
# When True, the dataset reorders the opacity-selected Gaussians along a Z-order
# space-filling curve so target slot i maps to a spatially-stable location across
# scenes. This is the primary fix for the element-wise reconstruction floor: with
# opacity ordering, slot i = "the i-th most opaque Gaussian", a different physical
# point in every scene, so the per-slot regression target is unlearnable and the
# loss plateaus. With Morton ordering slot i is a stable spatial location aligned
# with the decoder's voxel token grid, which makes the element-wise loss learnable.
# Cost: one sort at preload, zero at train time.
#
# Not needed when USE_CHAMFER_LOSS=True (Chamfer is order-free), but harmless.
MORTON_ORDER=True

# Which space-filling curve to use when MORTON_ORDER=True.
#   hilbert (default, RECOMMENDED) — provably better locality than Z-order:
#     consecutive slots are ALWAYS spatially adjacent (single-step L1 distance = 1,
#     zero jumps), so the decoder learns a smooth Lipschitz slot->position curve.
#     Measured on 10k random points: mean consecutive spacing 0.49 vs Morton 0.61.
#     Used by Point Transformer V3, OctFormer, HydraMamba, Voxel Mamba for exactly
#     this locality reason.
#   morton — Z-order (bit-interleave). Cheaper conceptually but teleports across the
#     volume when high bits flip (max single-step L1 jump 15, 255 discontinuities on
#     an 8^3 grid). Kept for ablation / backward comparison with your last run.
ORDER_CURVE="hilbert"

# Frame for the space-filling sort (the key fix from the paper's HilbertSort3D).
#   10.0 (RECOMMENDED) — FIXED canonical frame [-10,10], i.e. the radius your data is
#     normalized to. The Hilbert curve then traverses the SAME absolute cells in the
#     SAME order for every scene, so target slot i means a consistent physical place
#     across scenes and the decoder learns ONE scene-agnostic slot->position map. This
#     is what the original Can3Tok HilbertSort3D does (fixed origin/radius) and is the
#     point of a *canonical* tokenization.
#   <=0 — legacy PER-SCENE min-max: each scene's bounding box is stretched to the grid,
#     so slot i is scene-idiosyncratic. This is what the earlier Hilbert runs used and
#     is a likely contributor to the full-scene generalization gap. Set to 0 to A/B.
ORDER_FRAME_RADIUS=10.0

# ── Reconstruction objective ──────────────────────────────────────────────────
# USE_CHAMFER_LOSS=False (default): element-wise L2 (torch.norm(pred[i]-tgt[i])).
#   Pair with MORTON_ORDER=True so the per-slot target is learnable.
# USE_CHAMFER_LOSS=True: permutation-invariant Chamfer loss (nearest-neighbour
#   matching on position). Order-free, so MORTON_ORDER is not required. Slower
#   (NN search per scene). Use this as the principled backup if Morton+element-wise
#   still shows a gap. When Chamfer is on, the printed "Recon" line is the Chamfer
#   value; "Pos"/"Col"/... remain index-matched diagnostics.
USE_CHAMFER_LOSS=False
CHAMFER_CHUNK=2048   # NN-search chunk size; lower if you hit OOM with Chamfer

BATCH_SIZE=90
NUM_EPOCHS=5000
LEARNING_RATE=1e-4
KL_WEIGHT=1e-5
KL_ANNEAL_STEPS=0
LR_RESTART_T0=800
EVAL_EVERY=10
WEIGHT_DECAY=1e-2
WARMUP_STEPS=300
LR_MIN_RATIO=0.1
FAILURE_THRESHOLD=100

TRAIN_SCENES=3800
# RANDOM_SUBSET_SEED MUST be empty for a clean chunk split. If set, training samples a
# RANDOM 3800 of 3888 chunks while the held-out val skips the first 3800 SORTED chunks,
# so the two overlap (~86 of the 88 "held-out" chunks were trained on). The training
# script now rejects this with a fatal CHUNK SPLIT CONTAMINATED error.
RANDOM_SUBSET_SEED=""
VAL_SCENES=50          # full-scene val (val/ dir) — the PRIMARY thesis metric
# Held-out chunk count. 3888 total - 3800 train = 88. Empty -> use all remaining chunks
# after training (also 88 here). These are disjoint from training by construction.
CHUNK_VAL_SCENES=88
SAMPLING_METHOD="opacity"

# Extra full-scene datasets are intentionally OFF for the clean chunk experiment so the
# 3800/88 split is pure interior_gs chunks and the held-out-chunk metric is unambiguous.
# (They do not affect chunk-val disjointness — different roots — so you can re-enable
# them if you specifically want chunk+full mixed training.)
EXTRA_TRAIN_PATHS=""
EXTRA_TRAIN_SCENES=""

USE_CANONICAL_NORM=True
CHUNK_NORM_FACTOR=True
SCALE_NORM_MODE="linear"

PCA_VIS_FREQ=1000
PCA_NUM_SCENES=3
PCA_BRIGHTNESS=1.25
RECON_PLY_FREQ=1000
RECON_PLY_NUM_SCENES=3
RECON_PLY_MAX_SH=3

export WANDB_API_KEY="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"
USE_WANDB=True

# ============================================================================
# VALIDATION
# ============================================================================

_any_B=false
[ "$DECODER_LAYOUT_CROSS_ATTN" = "True" ] && _any_B=true
[ "$DECODER_LAYOUT_ADDITIVE"   = "True" ] && _any_B=true

if [ "$SEMANTIC_TOKEN_HEADS" = "True" ] && [ "$LATENT_DISENTANGLE" = "False" ]; then
    echo "ERROR: SEMANTIC_TOKEN_HEADS requires LATENT_DISENTANGLE=True"; exit 1
fi

# Validate CROP_PERCENTILE is numeric and in (0, 100]
_CP_CHECK=$(python3 -c "
v = float('$CROP_PERCENTILE')
if v <= 0 or v > 100:
    raise ValueError(f'CROP_PERCENTILE must be in (0, 100], got {v}')
print('ok')
" 2>&1)
if [ "$_CP_CHECK" != "ok" ]; then
    echo "ERROR: CROP_PERCENTILE=$CROP_PERCENTILE is invalid: $_CP_CHECK"
    exit 1
fi

ACTIVE_STRATEGY="C (baseline)"
if [ "$LATENT_DISENTANGLE" = "True" ] && [ "$_any_B" = "false" ]; then
    ACTIVE_STRATEGY="A — 16+496 in sequence (BEST)"
elif [ "$DECODER_LAYOUT_CROSS_ATTN" = "True" ] && [ "$DECODER_LAYOUT_ADDITIVE" = "True" ]; then
    ACTIVE_STRATEGY="B3 — 512 geom + additive + cross-attn"
elif [ "$DECODER_LAYOUT_CROSS_ATTN" = "True" ]; then
    ACTIVE_STRATEGY="B1 — 512 geom + cross-attn per layer"
elif [ "$DECODER_LAYOUT_ADDITIVE" = "True" ]; then
    ACTIVE_STRATEGY="B2 — 512 geom + additive bias"
fi

echo "========================================================================"
echo "  CAN3TOK — Strategy: $ACTIVE_STRATEGY"
if [ "$TOKEN_LOCAL_DECODER" = "True" ]; then
    echo "  TOKEN-LOCAL DECODER ENABLED"
fi
# ── Spatial crop summary ─────────────────────────────────────────────────────
_CP_INT=$(python3 -c "print(int(float('$CROP_PERCENTILE')))")
if [ "$_CP_INT" -lt 100 ]; then
    echo "  SPATIAL CROP: keeping inner ${CROP_PERCENTILE}% of each scene by"
    echo "     distance from centroid before opacity sampling."
else
    echo "  Spatial crop    : disabled (CROP_PERCENTILE=100)"
fi
# ── Ordering + objective summary ─────────────────────────────────────────────
if [ "$MORTON_ORDER" = "True" ]; then
    _FRAME_DESC=$(python3 -c "r=float('$ORDER_FRAME_RADIUS'); print(f'canonical frame [-{r:g},{r:g}]' if r>0 else 'per-scene min-max (legacy)')")
    echo "  GAUSSIAN ORDER  : ${ORDER_CURVE^^} space-filling curve, ${_FRAME_DESC}"
else
    echo "  Gaussian order  : opacity rank (default)"
fi
if [ "$USE_CHAMFER_LOSS" = "True" ]; then
    echo "  RECON OBJECTIVE : CHAMFER (permutation-invariant, order-free)  chunk=$CHAMFER_CHUNK"
else
    echo "  Recon objective : element-wise L2 (pair with MORTON_ORDER=True)"
fi
echo "  TRAIN_DATA=$TRAIN_DATA  TRAIN_SCENES=$TRAIN_SCENES  VAL_SCENES=$VAL_SCENES"
echo "========================================================================"
echo ""

# ============================================================================
# ENVIRONMENT
# ============================================================================

module purge && module load 2023 && module load CUDA/12.1.1
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512
export PATH="/home/yli11/.conda/envs/can3tok/bin:$PATH"
export LD_LIBRARY_PATH="/home/yli11/.conda/envs/can3tok/lib/python3.11/site-packages/torch/lib:$LD_LIBRARY_PATH"

cd /home/yli11/scratch-project/Hafeez_thesis/Can3Tok
mkdir -p logs_ss1 checkpoints_stage1

[ "$USE_WANDB" = "True" ] && wandb login $WANDB_API_KEY --relogin 2>/dev/null

# ── point_feats check ─────────────────────────────────────────────────────────
YAML_PATH="./model/configs/aligned_shape_latents/shapevae-256.yaml"
if [ -f "$YAML_PATH" ]; then
    POINT_FEATS=$(grep "point_feats:" "$YAML_PATH" | awk '{print $2}')
    [ "$POINT_FEATS" != "11" ] && echo "ERROR: point_feats=$POINT_FEATS, expected 11" && exit 1
    echo "  point_feats=11 confirmed"
fi

# ── norm_factor.npy pre-flight check (chunks/combined only) ──────────────────
if [ "$TRAIN_DATA" = "chunks" ] || [ "$TRAIN_DATA" = "combined" ]; then
    CHUNKS_DIR="/home/yli7/scratch/datasets/gaussian_world/preprocessed/interior_gs/train_grid1.0cm_chunk8x8_stride6x6"
    echo ""
    echo "  Pre-flight: checking norm_factor.npy in chunk dirs..."

    _NF_COUNT=$(ls "$CHUNKS_DIR" | sort | head -50 | while read d; do
        [ -f "$CHUNKS_DIR/$d/norm_factor.npy" ] && echo "ok"
    done | wc -l)

    if [ "$_NF_COUNT" -eq 50 ]; then
        echo "  norm_factor.npy: 50/50 sampled chunks OK — global frame confirmed"
        _EX_DIR=$(ls "$CHUNKS_DIR" | sort | head -1)
        echo "  Example: $_EX_DIR"
        python3 -c "
import numpy as np, sys
nf = np.load('$CHUNKS_DIR/$_EX_DIR/norm_factor.npy')
print(f'    center=({nf[0]:.3f}, {nf[1]:.3f}, {nf[2]:.3f})  scale={nf[3]:.4f}')
if nf[3] <= 0:
    print('ERROR: scale_factor <= 0 — corrupt norm_factor.npy!')
    sys.exit(1)
"
    elif [ "$_NF_COUNT" -gt 0 ]; then
        echo "  WARNING: norm_factor.npy found in only $_NF_COUNT/50 sampled chunks."
    else
        echo "  ERROR: norm_factor.npy missing from all 50 sampled chunks!"
        exit 1
    fi
    echo ""
fi

echo ""

# ============================================================================
# BUILD COMMAND
# ============================================================================

ACCELERATE_CONFIG="/home/yli11/scratch-project/Hafeez_thesis/Can3Tok/job_scripts/accelerate_config.yaml"
TRAIN_CMD="accelerate launch --config_file $ACCELERATE_CONFIG gs_can3tok_2.py"

TRAIN_CMD="$TRAIN_CMD --train_data $TRAIN_DATA"
TRAIN_CMD="$TRAIN_CMD --batch_size $BATCH_SIZE --num_epochs $NUM_EPOCHS"
TRAIN_CMD="$TRAIN_CMD --lr $LEARNING_RATE --kl_weight $KL_WEIGHT --kl_anneal_steps $KL_ANNEAL_STEPS"
TRAIN_CMD="$TRAIN_CMD --weight_decay $WEIGHT_DECAY --warmup_steps $WARMUP_STEPS"
TRAIN_CMD="$TRAIN_CMD --lr_min_ratio $LR_MIN_RATIO --lr_restart_T0 $LR_RESTART_T0 --eval_every $EVAL_EVERY"
TRAIN_CMD="$TRAIN_CMD --train_scenes $TRAIN_SCENES --val_scenes $VAL_SCENES"
[ -n "$CHUNK_VAL_SCENES" ] && TRAIN_CMD="$TRAIN_CMD --chunk_val_scenes $CHUNK_VAL_SCENES"
TRAIN_CMD="$TRAIN_CMD --sampling_method $SAMPLING_METHOD"

[ "$DECODER_LAYOUT_CROSS_ATTN" = "True" ] && TRAIN_CMD="$TRAIN_CMD --decoder_layout_cross_attn"
[ "$DECODER_LAYOUT_ADDITIVE"   = "True" ] && TRAIN_CMD="$TRAIN_CMD --decoder_layout_additive"

[ "$LATENT_DISENTANGLE" = "True" ] && TRAIN_CMD="$TRAIN_CMD --latent_disentangle"
TRAIN_CMD="$TRAIN_CMD --semantic_dims $SEMANTIC_DIMS"
TRAIN_CMD="$TRAIN_CMD --cross_recon_weight $CROSS_RECON_WEIGHT --ortho_weight $ORTHO_WEIGHT"

[ "$COLOR_RESIDUAL" = "True" ] && TRAIN_CMD="$TRAIN_CMD --color_residual"
TRAIN_CMD="$TRAIN_CMD --mean_color_weight $MEAN_COLOR_WEIGHT --color_loss_weight $COLOR_LOSS_WEIGHT"

[ "$SCENE_SEMANTIC_HEAD"      = "True" ] && TRAIN_CMD="$TRAIN_CMD --scene_semantic_head"
TRAIN_CMD="$TRAIN_CMD --scene_semantic_weight $SCENE_SEMANTIC_WEIGHT"
[ "$SCENE_LAYOUT_HEAD"        = "True" ] && TRAIN_CMD="$TRAIN_CMD --scene_layout_head"
[ "$STRUCTURED_LAYOUT_TOKENS" = "True" ] && TRAIN_CMD="$TRAIN_CMD --structured_layout_tokens"
TRAIN_CMD="$TRAIN_CMD --layout_loss_weight $LAYOUT_LOSS_WEIGHT"
[ "$SEMANTIC_TOKEN_HEADS"     = "True" ] && TRAIN_CMD="$TRAIN_CMD --semantic_token_heads"

TRAIN_CMD="$TRAIN_CMD --zs_pool_infonce_weight $ZS_POOL_INFONCE_WEIGHT"
TRAIN_CMD="$TRAIN_CMD --zs_pool_infonce_temperature $ZS_POOL_INFONCE_TEMPERATURE"
TRAIN_CMD="$TRAIN_CMD --zs_layout_infonce_weight $ZS_LAYOUT_INFONCE_WEIGHT"
TRAIN_CMD="$TRAIN_CMD --zs_layout_infonce_temperature $ZS_LAYOUT_INFONCE_TEMPERATURE"
TRAIN_CMD="$TRAIN_CMD --zs_token_infonce_weight $ZS_TOKEN_INFONCE_WEIGHT"
TRAIN_CMD="$TRAIN_CMD --zs_token_infonce_temperature $ZS_TOKEN_INFONCE_TEMPERATURE"
TRAIN_CMD="$TRAIN_CMD --z_s_infonce_weight $Z_S_INFONCE_WEIGHT"
TRAIN_CMD="$TRAIN_CMD --z_s_infonce_temperature $Z_S_INFONCE_TEMPERATURE"
TRAIN_CMD="$TRAIN_CMD --z_s_infonce_delta $Z_S_INFONCE_DELTA"

TRAIN_CMD="$TRAIN_CMD --semantic_mode $SEMANTIC_MODE"
TRAIN_CMD="$TRAIN_CMD --segment_loss_weight $SEGMENT_WEIGHT"
TRAIN_CMD="$TRAIN_CMD --instance_loss_weight $INSTANCE_WEIGHT"
TRAIN_CMD="$TRAIN_CMD --semantic_temperature $SEMANTIC_TEMP"
TRAIN_CMD="$TRAIN_CMD --semantic_subsample $SEMANTIC_SUBSAMPLE"
TRAIN_CMD="$TRAIN_CMD --sampling_strategy $SAMPLING_STRATEGY"

[ "$DECODER_POS_ENC"    = "True" ] && TRAIN_CMD="$TRAIN_CMD --decoder_pos_enc"
[ "$DECODER_FOURIER_PE" = "True" ] && TRAIN_CMD="$TRAIN_CMD --decoder_fourier_pe"
[ "$TOKEN_LOCAL_DECODER" = "True" ] && TRAIN_CMD="$TRAIN_CMD --token_local_decoder"

[ "$TOKEN_COND"       = "True" ] && TRAIN_CMD="$TRAIN_CMD --token_cond --token_cond_approach $TOKEN_COND_APPROACH"
[ "$TOKEN_COND_ADALN" = "True" ] && TRAIN_CMD="$TRAIN_CMD --token_cond_adaln"

TRAIN_CMD="$TRAIN_CMD --scale_penalty_weight $SCALE_PENALTY_WEIGHT"
TRAIN_CMD="$TRAIN_CMD --scale_penalty_threshold $SCALE_PENALTY_THRESHOLD"

TRAIN_CMD="$TRAIN_CMD --scale_norm_mode $SCALE_NORM_MODE"
[ "$USE_CANONICAL_NORM"  = "False" ] && TRAIN_CMD="$TRAIN_CMD --no_canonical_norm"
[ "$CHUNK_NORM_FACTOR"   = "False" ] && TRAIN_CMD="$TRAIN_CMD --no_chunk_norm_factor"

TRAIN_CMD="$TRAIN_CMD --pca_vis_freq $PCA_VIS_FREQ --pca_num_scenes $PCA_NUM_SCENES"
TRAIN_CMD="$TRAIN_CMD --pca_brightness $PCA_BRIGHTNESS"
TRAIN_CMD="$TRAIN_CMD --recon_ply_freq $RECON_PLY_FREQ --recon_ply_num_scenes $RECON_PLY_NUM_SCENES"
TRAIN_CMD="$TRAIN_CMD --recon_ply_max_sh $RECON_PLY_MAX_SH"

[ "$USE_WANDB" = "True" ] && TRAIN_CMD="$TRAIN_CMD --use_wandb --wandb_project Can3Tok-SceenSplat-7K --wandb_entity 3D-SSC"

[ -n "$RANDOM_SUBSET_SEED" ] && TRAIN_CMD="$TRAIN_CMD --random_subset_seed $RANDOM_SUBSET_SEED"

# ── Spatial crop ──────────────────────────────────────────────────────────────
# When CROP_PERCENTILE=100.0 the dataset disables cropping internally.
TRAIN_CMD="$TRAIN_CMD --crop_percentile $CROP_PERCENTILE"

# ── Gaussian ordering ─────────────────────────────────────────────────────────
[ "$MORTON_ORDER" = "True" ] && TRAIN_CMD="$TRAIN_CMD --morton_order"
TRAIN_CMD="$TRAIN_CMD --order_curve $ORDER_CURVE"
TRAIN_CMD="$TRAIN_CMD --order_frame_radius $ORDER_FRAME_RADIUS"

# ── Reconstruction objective ──────────────────────────────────────────────────
[ "$USE_CHAMFER_LOSS" = "True" ] && TRAIN_CMD="$TRAIN_CMD --use_chamfer_loss"
TRAIN_CMD="$TRAIN_CMD --chamfer_chunk $CHAMFER_CHUNK"

if [ -n "$RESUME_CHECKPOINT" ]; then
    TRAIN_CMD="$TRAIN_CMD --resume_checkpoint $RESUME_CHECKPOINT"
    [ -n "$RESUME_EPOCH" ] && TRAIN_CMD="$TRAIN_CMD --resume_epoch $RESUME_EPOCH"
fi

[ -n "$EXTRA_TRAIN_PATHS"  ] && TRAIN_CMD="$TRAIN_CMD --extra_train_paths $EXTRA_TRAIN_PATHS"
[ -n "$EXTRA_TRAIN_SCENES" ] && TRAIN_CMD="$TRAIN_CMD --extra_train_scenes $EXTRA_TRAIN_SCENES"

echo "Command: $TRAIN_CMD"
echo ""

# ============================================================================
# RUN
# ============================================================================

SECONDS=0
eval $TRAIN_CMD
TRAIN_EXIT=$?
echo ""
echo "Exit: $TRAIN_EXIT  |  Duration: $((SECONDS/60))m $((SECONDS%60))s  |  End: $(date)"

if [ $TRAIN_EXIT -eq 0 ]; then
    echo ""
    echo "COMPLETED. Strategy: $ACTIVE_STRATEGY | Data: $TRAIN_DATA | Crop: ${CROP_PERCENTILE}% | Order: ${MORTON_ORDER}/${ORDER_CURVE} | Chamfer: $USE_CHAMFER_LOSS"
    echo ""
    echo "  Useful log greps:"
    echo "  Best full-scene model  : grep 'NEW BEST' logs_ss1/can3tok_${SLURM_JOB_ID}.out | tail -5"
    echo "  Val full scenes (L2)   : grep 'Val FULL SCENES' logs_ss1/can3tok_${SLURM_JOB_ID}.out"
    echo "  Position convergence   : grep 'Pos=' logs_ss1/can3tok_${SLURM_JOB_ID}.out | head -20"
    echo "  Recon objective        : grep 'RECON OBJECTIVE' logs_ss1/can3tok_${SLURM_JOB_ID}.out"
    echo "  Gaussian order         : grep 'GAUSSIAN ORDER' logs_ss1/can3tok_${SLURM_JOB_ID}.out"
else
    echo "FAILED (exit $TRAIN_EXIT)"
    echo "  Error log: cat logs_ss1/can3tok_${SLURM_JOB_ID}.err"
fi